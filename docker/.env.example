# Copy this file to docker/.env and replace every empty secret before starting.

DOC_ENGINE=${DOC_ENGINE:-elasticsearch}
COMPOSE_PROFILES=${DOC_ENGINE}

# Elasticsearch
STACK_VERSION=8.11.3
ES_HOST=localhost
ES_PORT=1200
ELASTIC_PASSWORD=
KIBANA_PORT=6601
KIBANA_USER=kibana_system
KIBANA_PASSWORD=
KIBANA_SYSTEM_PASSWORD=
MEM_LIMIT=3221225472
ES_JAVA_OPTS=-Xms2g -Xmx2g
OMP_NUM_THREADS=4
KIBANA_MEM_LIMIT=1g
MYSQL_MEM_LIMIT=1536m
MINIO_MEM_LIMIT=768m
REDIS_MEM_LIMIT=384m

# Infinity
INFINITY_HOST=infinity
INFINITY_THRIFT_PORT=23817
INFINITY_HTTP_PORT=23820
INFINITY_PSQL_PORT=5432

# MySQL
MYSQL_PASSWORD=
MYSQL_HOST=localhost
MYSQL_DBNAME=cvte_rag_plus
MYSQL_PORT=5455

# MinIO
MINIO_HOST=localhost
# Set this to the LAN or public address used by browsers.
MINIO_VISIT_HOST=localhost
MINIO_CONSOLE_PORT=9001
MINIO_PORT=9000
# Public endpoint used for browser multipart uploads. Leave empty to fall back
# to MINIO_VISIT_HOST:MINIO_PORT. Use the HTTPS reverse-proxy URL in production.
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
# Required for browser PUT requests carrying Content-MD5.
MINIO_API_CORS_ALLOW_ORIGIN=*
MINIO_CORS_ORIGINS=http://localhost,http://localhost:8000,http://localhost:8888,http://localhost:3333,http://localhost:3000
MINIO_API_STALE_UPLOADS_EXPIRY=24h
MINIO_API_STALE_UPLOADS_CLEANUP_INTERVAL=1h
MINIO_USER=cvte_rag_plus
MINIO_PASSWORD=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Application
SVR_HTTP_PORT=9380
APP_ROOT=/app
CVTE_RAG_PLUS_BASE_IMAGE=
CVTE_RAG_PLUS_IMAGE=cvte-rag-plus:v0.6.0
CVTE_RAG_PLUS_MANAGEMENT_WEB_IMAGE=cvte-rag-plus-management-web:v0.6.0
CVTE_RAG_PLUS_MANAGEMENT_SERVER_IMAGE=cvte-rag-plus-management-server:v0.6.0
TIMEZONE='Asia/Shanghai'
HF_ENDPOINT=https://hf-mirror.com
MACOS=""
MAX_CONTENT_LENGTH=10737418240

# Required only when LocalLLM RPC is enabled.
CVTE_RAG_PLUS_RPC_AUTHKEY=

# Management authentication
MANAGEMENT_ADMIN_USERNAME=admin
MANAGEMENT_ADMIN_PASSWORD=
# Optional; defaults to 8 hours.
AUTH_TOKEN_TTL_SECONDS=28800
